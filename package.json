{
  "name": "nomos-erudit",
  "version": "0.1.0",
  "private": true,
  "description": "Production foundation for the Erudit RAG assistant of Nomos College",
  "workspaces": [
    "widget",
    "backend",
    "ingestion",
    "admin"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
